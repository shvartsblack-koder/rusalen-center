{
  "name": "TicketOrder",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID \u0441\u043e\u0431\u044b\u0442\u0438\u044f"
    },
    "event_title": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u044f (\u043a\u044d\u0448)"
    },
    "event_star": {
      "type": "string",
      "description": "\u0421\u043f\u0438\u043a\u0435\u0440 (\u043a\u044d\u0448)"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "\u0414\u0430\u0442\u0430 \u0441\u043e\u0431\u044b\u0442\u0438\u044f"
    },
    "name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "phone": {
      "type": "string",
      "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0431\u0438\u043b\u0435\u0442\u043e\u0432"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "paid",
        "cancelled"
      ],
      "default": "new",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u0437\u0430\u043a\u0430\u0437\u0430"
    }
  },
  "required": [
    "event_id",
    "name",
    "email"
  ]
}