{
  "name": "ForumTopic",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0442\u0435\u043c\u044b"
    },
    "content": {
      "type": "string",
      "description": "\u0421\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435 \u0442\u0435\u043c\u044b"
    },
    "category": {
      "type": "string",
      "enum": [
        "publication",
        "method",
        "general",
        "supertopic"
      ],
      "description": "\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f",
      "default": "general"
    },
    "author_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0430\u0432\u0442\u043e\u0440\u0430"
    },
    "author_id": {
      "type": "string",
      "description": "ID \u0430\u0432\u0442\u043e\u0440\u0430"
    },
    "is_closed": {
      "type": "boolean",
      "default": false,
      "description": "\u0422\u0435\u043c\u0430 \u0437\u0430\u043a\u0440\u044b\u0442\u0430"
    }
  },
  "required": [
    "title",
    "content",
    "category"
  ]
}