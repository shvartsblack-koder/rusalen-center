{
  "description": "\u041a\u0430\u0436\u0434\u044b\u0439 \u043f\u043e\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u0438\u043a \u0432 10:00 \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442 \u0432 \u043b\u0435\u043d\u0442\u0443 \u043d\u043e\u0432\u043e\u0441\u0442\u0435\u0439 \u043d\u043e\u0432\u044b\u0439 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b \u043e\u0431 \u0443\u0447\u0430\u0441\u0442\u0438\u0438 \u0420\u0423\u0421\u0410\u041b\u0415\u041d \u0432 \u0432\u044b\u0441\u0442\u0430\u0432\u043a\u0430\u0445, \u0444\u043e\u0440\u0443\u043c\u0430\u0445 \u0438 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u044f\u0445",
  "name": "\u0415\u0436\u0435\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u043d\u043e\u0432\u043e\u0441\u0442\u0438 \u0420\u0423\u0421\u0410\u041b\u0415\u041d",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_news_rusalen",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "publish_news": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "publish-weekly-news"
          },
          "then": "end",
          "x-base44": {
            "title": "\u041f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044f \u043d\u043e\u0432\u043e\u0441\u0442\u0438 \u043d\u0435\u0434\u0435\u043b\u0438",
            "description": "\u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b \u0438\u0437 \u043e\u0447\u0435\u0440\u0435\u0434\u0438"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 * * 1",
      "one_time_date": null,
